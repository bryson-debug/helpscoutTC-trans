# --- HelpScout Dynamic App ---
# Secret key issued when you register the Dynamic App in the HelpScout Developer portal.
# Used to verify the X-HelpScout-Signature header (HMAC-SHA1) on every incoming request.
HELPSCOUT_APP_SECRET=

# --- ThriveCart Transactions API (read-only) ---
# API key created from ThriveCart account settings, or an OAuth access token.
THRIVECART_API_KEY=

# Base URL for the ThriveCart API. Confirm against https://developers.thrivecart.com/
# at build/setup time -- this is the value used by the official PHP SDK's default client.
THRIVECART_API_BASE=https://thrivecart.com/api/external

# Template used to build the "View in ThriveCart" link for a customer's transactions
# profile. {customerId} and {email} are substituted. CONFIRM the real profile URL
# pattern in your ThriveCart account before going live -- see README "Open Assumptions".
THRIVECART_CUSTOMER_URL_TEMPLATE=https://thrivecart.com/customer/{customerId}

# --- Retry token signing ---
# Random secret used to sign short-lived tokens for the client-side "Retry" button.
# Generate with: openssl rand -hex 32
RETRY_TOKEN_SECRET=

# --- Local/dev testing only ---
# When "true", lib/thrivecart.js returns canned mock data instead of calling the
# real ThriveCart API. Never set this in production.
THRIVECART_MOCK=false
