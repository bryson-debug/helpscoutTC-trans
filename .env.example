# --- HelpScout Dynamic Content app ---
# The "Content signature key" you set when registering the app in HelpScout's
# Developer portal. Used to verify the X-HelpScout-Signature query parameter
# on every incoming request (HMAC-SHA1 of the other query params, base64).
HELPSCOUT_APP_SECRET=

# --- HelpScout Mailbox API (OAuth2, read-only) ---
# HelpScout's Dynamic Content request only sends a `customer-id`, not an
# email, so we resolve it via the Mailbox API. This requires a SEPARATE
# OAuth2 "My App" registered under your HelpScout profile (Client
# Credentials grant) -- not the same thing as HELPSCOUT_APP_SECRET above.
HELPSCOUT_OAUTH_CLIENT_ID=
HELPSCOUT_OAUTH_CLIENT_SECRET=

# --- ThriveCart Transactions API (read-only) ---
# API key created from ThriveCart account settings, or an OAuth access token.
THRIVECART_API_KEY=

# Base URL for the ThriveCart API -- confirmed correct against a live request.
THRIVECART_API_BASE=https://thrivecart.com/api/external

# Template used to build the "View in ThriveCart" link. ThriveCart's customer
# API returns no customer ID at all (confirmed live), so this is built from
# email -- {email} is substituted. STILL A GUESS: confirm the real ThriveCart
# dashboard search/profile URL pattern -- see README "Open Assumptions".
THRIVECART_CUSTOMER_URL_TEMPLATE=https://thrivecart.com/customers?search={email}

# --- Retry token signing ---
# Random secret used to sign short-lived tokens for the client-side "Retry" button.
# Generate with: openssl rand -hex 32
RETRY_TOKEN_SECRET=

# --- Local/dev testing only ---
# When "true", lib/thrivecart.js and lib/helpscoutApi.js return canned mock
# data instead of calling the real APIs. Never set either in production.
THRIVECART_MOCK=false
HELPSCOUT_MOCK=false
